<Window x:Class="UniversalTrackIR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniversalTrackIR.ViewModels"
        xmlns:local="clr-namespace:UniversalTrackIR"
        Title="Universal TrackIR" Icon="Assets/UniversalTrackIR.ico" Width="1440" Height="940" MinWidth="1180" MinHeight="640"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />

        <!-- Scroll over any slider: one small step per notch, a tenth with Shift. Keeps the page from scrolling. -->
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <EventSetter Event="PreviewMouseWheel" Handler="Slider_MouseWheel" />
        </Style>

        <!-- One head axis: on/off, four sliders, invert, live readout -->
        <DataTemplate x:Key="AxisRow" DataType="{x:Type vm:AxisViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="{Binding Description}">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </CheckBox>

                <DockPanel Grid.Column="1" Margin="0,0,16,0" IsEnabled="{Binding Enabled}">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SensitivityText}" />
                    <Slider Minimum="0" Maximum="{Binding SensitivityMax}" SmallChange="0.1" LargeChange="0.5"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Sensitivity}"
                            ToolTip="How far the game view moves per degree of head movement. 4x: turn 10°, look 40°." />
                </DockPanel>

                <DockPanel Grid.Column="2" Margin="0,0,16,0" IsEnabled="{Binding Enabled}">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding CurveText}" />
                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CurvePercent}"
                            ToolTip="Linear: same speed everywhere. Higher: calm near center for aiming, quick toward the edges." />
                </DockPanel>

                <DockPanel Grid.Column="3" Margin="0,0,16,0" IsEnabled="{Binding Enabled}">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding DeadzoneText}" />
                    <Slider Minimum="0" Maximum="{Binding DeadzoneMax}" SmallChange="{Binding DeadzoneStep}" LargeChange="1"
                            TickFrequency="{Binding DeadzoneStep}" IsSnapToTickEnabled="True" Value="{Binding Deadzone}"
                            ToolTip="Small head movements around center are ignored, so the view stays put while you sit still." />
                </DockPanel>

                <DockPanel Grid.Column="4" Margin="0,0,16,0" IsEnabled="{Binding Enabled}">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding LimitText}" />
                    <Slider Minimum="{Binding LimitMin}" Maximum="{Binding LimitMax}" SmallChange="{Binding LimitStep}" LargeChange="10"
                            TickFrequency="{Binding LimitStep}" IsSnapToTickEnabled="True" Value="{Binding Limit}"
                            ToolTip="The furthest the game view can go on this axis." />
                </DockPanel>

                <CheckBox Grid.Column="5" Content="Invert" IsChecked="{Binding Invert}" IsEnabled="{Binding Enabled}"
                          VerticalAlignment="Center" ToolTip="Tick this if the game moves the wrong way on this axis." />

                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LiveText}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Style="{StaticResource Meter}" FlowDirection="RightToLeft"
                                     Value="{Binding MeterLeft, Mode=OneWay}" />
                        <Border Grid.Column="1" Background="{StaticResource MutedTextBrush}" Height="8" />
                        <ProgressBar Grid.Column="2" Style="{StaticResource Meter}" Value="{Binding MeterRight, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Column headers that line up with AxisRow -->
        <DataTemplate x:Key="AxisHeader">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="SENSITIVITY" />
                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="CURVE" />
                <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="DEADZONE" />
                <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="LIMIT" />
                <TextBlock Grid.Column="6" Style="{StaticResource Caption}" Text="HEAD → GAME" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                      Content="Tracking on" IsChecked="{Binding IsEnabled}" />

            <!-- Updates from GitHub Releases -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="{Binding UpdateButtonText}" Command="{Binding InstallUpdateCommand}" Padding="12,5"
                        Margin="0,0,8,0" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Padding="12,5" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Universal TrackIR" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Your Tobii Eye Tracker 5 as head tracking in any game. Head for the big moves, eyes for the fine ones."
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Status + profile + quick actions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrackerConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource EyeBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding TrackerStatus}" FontWeight="SemiBold" />
                    </StackPanel>
                    <WrapPanel Margin="17,6,0,0">
                        <TextBlock Text="{Binding GameStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding MouseStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding VJoyStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding RateText}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" />
                    </WrapPanel>
                </StackPanel>

                <!-- Profiles -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,24,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="PROFILE" />
                        <Grid Width="220">
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      Visibility="{Binding IsRenaming, Converter={StaticResource NotBoolToVis}}"
                                      x:Name="ProfileBox" />
                            <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                     KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostFocus"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <Button Content="Rename" Command="{Binding StartRenameCommand}" Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="Duplicate" Command="{Binding DuplicateProfileCommand}" Padding="10,5" Margin="0,0,6,0"
                                ToolTip="Copy this profile, e.g. to tune one per game" />
                        <Button Content="Delete" Command="{Binding DeleteProfileCommand}" Padding="10,5" Margin="0,0,6,0" />
                        <Button Content="Reset" Command="{Binding ResetProfileCommand}" Padding="10,5"
                                ToolTip="Put every slider in this profile back to the defaults" />
                    </StackPanel>
                </StackPanel>

                <!-- Quick actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding RecenterCommand}" Padding="16,6" Margin="0,0,8,0" FontWeight="SemiBold"
                            Background="{StaticResource AccentBrush}" Foreground="#1A0C00"
                            ToolTip="Look straight at the screen, then press. That's the new center.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Recenter" />
                            <TextBlock Text="{Binding RecenterKeyText, StringFormat='  ({0})'}" FontWeight="Normal" />
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <CheckBox Content="Eyes" IsChecked="{Binding EyesOn}" VerticalAlignment="Center"
                              ToolTip="Quick switch for eye tracking. The setting below stays as it is." />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="17,10,0,0" Foreground="{StaticResource WarnBrush}"
                           TextWrapping="Wrap" Text="{Binding Warning}"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Live view -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PoseText}" FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Bottom" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Live view" />
                        </DockPanel>

                        <!-- Where the game is looking. Orange: head. Green ring: head + eyes (what the game gets). -->
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8" HorizontalAlignment="Center"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                            <Canvas Width="440" Height="230">
                                <Line X1="220" Y1="0" X2="220" Y2="230" Stroke="{StaticResource LineBrush}" StrokeThickness="1" />
                                <Line X1="0" Y1="115" X2="440" Y2="115" Stroke="{StaticResource LineBrush}" StrokeThickness="1" />
                                <Line X1="110" Y1="0" X2="110" Y2="230" Stroke="{StaticResource LineBrush}" StrokeThickness="1" StrokeDashArray="2 4" />
                                <Line X1="330" Y1="0" X2="330" Y2="230" Stroke="{StaticResource LineBrush}" StrokeThickness="1" StrokeDashArray="2 4" />
                                <TextBlock Canvas.Left="114" Canvas.Top="4" Text="45° left" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Canvas.Left="334" Canvas.Top="4" Text="45° right" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Canvas.Left="4" Canvas.Top="4" Text="90°" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Canvas.Left="412" Canvas.Top="4" Text="90°" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />

                                <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"
                                         Canvas.Left="{Binding HeadDotX}" Canvas.Top="{Binding HeadDotY}"
                                         Visibility="{Binding HeadVisible, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="16" Height="16" Stroke="{StaticResource EyeBrush}" StrokeThickness="3"
                                         Canvas.Left="{Binding FinalDotX}" Canvas.Top="{Binding FinalDotY}"
                                         Visibility="{Binding HeadVisible, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Canvas.Left="0" Canvas.Top="100" Width="440" TextAlignment="Center"
                                           Text="Waiting for your head..." Foreground="{StaticResource MutedTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeadVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Canvas>
                        </Border>

                        <WrapPanel Margin="0,10,0,0">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Head" Margin="0,0,16,0" Foreground="{StaticResource MutedTextBrush}" />
                            <Ellipse Width="10" Height="10" Stroke="{StaticResource EyeBrush}" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Head + eyes (what the game gets)" Foreground="{StaticResource MutedTextBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Eyes -->
                <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <CheckBox DockPanel.Dock="Right" Content="On" IsChecked="{Binding Eye.Enabled}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Eye tracking" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Look toward the edge of the screen and the view keeps going a little further. Inside the box in the middle your eyes do nothing, so reading gauges doesn't move the view." />

                        <Grid IsEnabled="{Binding Eye.Enabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Caption}" Text="EXTRA YAW AT SCREEN EDGE" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Eye.YawRange, StringFormat='{}{0:0}°'}" />
                                    <Slider Minimum="0" Maximum="60" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Eye.YawRange}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource Caption}" Text="EXTRA PITCH AT SCREEN EDGE" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Eye.PitchRange, StringFormat='{}{0:0}°'}" />
                                    <Slider Minimum="0" Maximum="40" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Eye.PitchRange}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource Caption}" Text="CENTER DEADZONE" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Eye.DeadzonePercent, StringFormat='{}{0:0}%'}" />
                                    <Slider Minimum="0" Maximum="80" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Eye.DeadzonePercent}" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource Caption}" Text="CURVE" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Eye.CurvePercent, StringFormat='{}{0:0}%'}" />
                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Eye.CurvePercent}"
                                            ToolTip="Higher: eyes barely nudge the view just past the box, and push hard at the very edge." />
                                </DockPanel>

                                <TextBlock Style="{StaticResource Caption}" Text="SMOOTHING" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding Eye.Smoothing, StringFormat='{}{0:0}%'}" />
                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Eye.Smoothing}"
                                            ToolTip="Eyes dart around constantly. More smoothing = a calmer view, slower to follow your glance." />
                                </DockPanel>
                            </StackPanel>

                            <!-- Mini screen: where you're looking and the deadzone box -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Caption}" Text="YOUR SCREEN" />
                                <Border Background="{StaticResource BgBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" ClipToBounds="True">
                                    <Canvas Width="192" Height="108">
                                        <Rectangle Canvas.Left="{Binding GazeDeadzoneLeft}" Canvas.Top="{Binding GazeDeadzoneTop}"
                                                   Width="{Binding GazeDeadzoneWidth}" Height="{Binding GazeDeadzoneHeight}"
                                                   Stroke="{StaticResource LineBrush}" StrokeThickness="1" StrokeDashArray="3 3"
                                                   Fill="{StaticResource RaisedBrush}" RadiusX="3" RadiusY="3" />
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource EyeBrush}"
                                                 Canvas.Left="{Binding GazeDotX}" Canvas.Top="{Binding GazeDotY}"
                                                 Visibility="{Binding GazeVisible, Converter={StaticResource BoolToVis}}" />
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Head tracking: full width so the sliders get room -->
                <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="320"
                                        ToolTip="Higher: steadier view, a little more lag. Fast moves always come through quickly.">
                                <TextBlock Style="{StaticResource Caption}" Text="SMOOTHING" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider Width="180" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding HeadSmoothing}" />
                                <TextBlock Style="{StaticResource Value}" Text="{Binding HeadSmoothing, StringFormat='{}{0:0}%'}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Head tracking" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="You can only turn your head so far and still see the screen, so turning is amplified. Start with sensitivity, then use curve to calm the middle. Untick an axis to keep it out of the game." />

                        <ContentPresenter Content="ROTATION" ContentTemplate="{StaticResource AxisHeader}" />
                        <ItemsControl ItemsSource="{Binding RotationAxes}" ItemTemplate="{StaticResource AxisRow}" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12" />

                        <ContentPresenter Content="POSITION" ContentTemplate="{StaticResource AxisHeader}" />
                        <ItemsControl ItemsSource="{Binding PositionAxes}" ItemTemplate="{StaticResource AxisRow}" />
                    </StackPanel>
                </Border>

                <!-- Outputs -->
                <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Send to games" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- TrackIR / FreeTrack -->
                            <Border Grid.Column="0" Style="{StaticResource Inset}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding GameProtocolEnabled}" FontWeight="Bold" Content="TrackIR and FreeTrack" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                               Text="Games with head tracking support see this as a TrackIR. Star Citizen, DCS, MSFS, IL-2, Elite, ACC, iRacing, rFactor 2, AMS2, ETS2 and hundreds more. Turn on TrackIR in the game's settings." />
                                    <CheckBox IsChecked="{Binding RunTrackIrStandIn}" IsEnabled="{Binding GameProtocolEnabled}"
                                              Content="Run TrackIR.exe stand-in"
                                              ToolTip="Some games only offer head tracking while a program called TrackIR is running. Applies next time tracking starts." />
                                </StackPanel>
                            </Border>

                            <!-- Mouse -->
                            <Border Grid.Column="2" Style="{StaticResource Inset}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding MouseEnabled}" FontWeight="Bold" Content="Mouse look" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                               Text="For games without head tracking. Your head moves the mouse, so use it in free look or third-person cameras. Only works while the game below is in front." />
                                    <TextBlock Style="{StaticResource Caption}" Text="GAME PROCESS" />
                                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding MouseEnabled}">
                                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshProcessesCommand}" Padding="10,5" Margin="6,0,0,0" />
                                        <ComboBox IsEditable="True" ItemsSource="{Binding Processes}"
                                                  Text="{Binding MouseProcess, UpdateSourceTrigger=PropertyChanged, Delay=600}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="PIXELS PER DEGREE" />
                                    <DockPanel IsEnabled="{Binding MouseEnabled}" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding MousePixelsPerDegree, StringFormat='{}{0:0.0}'}" />
                                        <Slider Minimum="1" Maximum="60" SmallChange="0.5" LargeChange="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Value="{Binding MousePixelsPerDegree}"
                                                ToolTip="Raise until turning your head 90° turns the game camera 90°. Depends on the game's mouse sensitivity." />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding MouseEnabled}">
                                        <CheckBox Content="Yaw" IsChecked="{Binding MouseYaw}" Margin="0,0,16,0" />
                                        <CheckBox Content="Pitch" IsChecked="{Binding MousePitch}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- vJoy -->
                            <Border Grid.Column="4" Style="{StaticResource Inset}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding VJoyEnabled}" FontWeight="Bold" Content="Virtual joystick (vJoy)" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                               Text="For games that let you bind look controls to a joystick axis. Needs vJoy installed. Yaw, pitch and roll go to X, Y and Z. Position goes to Rx, Ry and Rz." />
                                    <TextBlock Style="{StaticResource Caption}" Text="VJOY DEVICE" />
                                    <ComboBox ItemsSource="{Binding VJoyDevices}" SelectedItem="{Binding VJoyDevice}" Width="80"
                                              HorizontalAlignment="Left" IsEnabled="{Binding VJoyEnabled}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Tip: while binding axes in the game, untick the other axes above so only the one you move changes." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Hotkeys" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Work while the game has focus. Click one, then press the combo. Backspace clears it." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Recenter" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyButton}" Margin="0,0,0,6"
                                    Content="{Binding RecenterKeyText}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="Recenter" />
                            <TextBlock Grid.Row="1" Text="Pause / resume" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyButton}" Margin="0,0,0,6"
                                    Content="{Binding PauseKeyText}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="Pause" />
                            <TextBlock Grid.Row="2" Text="Eyes on / off" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyButton}"
                                    Content="{Binding EyesKeyText}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="ToggleEyes" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Foreground="{StaticResource WarnBrush}"
                                       TextWrapping="Wrap" Text="{Binding HotkeyWarning}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
